NEXT_PUBLIC_API_URL=
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
JWT_SECRET=

# Admin / Dev auth fallback (when MSG91 is not configured)
# Comma-separated 10-digit numbers (India). Example: 9344562418,9000000000
ADMIN_PHONES=
# Optional: allow non-admin dev logins when MSG91 missing
DEV_OTP_ENABLED=false
DEV_AUTH_PHONES=
# Optional: override dev OTP code (default: 1234 for admin allowlisted phones)
DEV_OTP_CODE=

# Vercel Blob (for admin image uploads + admin-created campaigns/store items JSON)
BLOB_READ_WRITE_TOKEN=
