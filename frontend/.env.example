NEXT_PUBLIC_API_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional (client-side display/use only; keep same value as RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_ROUTE=
MSG91_DLT_ID=
# If your MSG91 account uses Flow API, set this and keep MSG91_TEMPLATE_ID empty.
MSG91_FLOW_ID=
# Optional OTP variable name used in your MSG91 Flow (default: OTP)
MSG91_FLOW_OTP_VAR=OTP
JWT_SECRET=

# Admin / Dev auth fallback (when MSG91 is not configured)
# Comma-separated 10-digit numbers (India). Example: 9344562418,9000000000
ADMIN_PHONES=
# Optional: allow non-admin dev logins when MSG91 missing
DEV_OTP_ENABLED=false
DEV_AUTH_PHONES=
# Optional: override dev OTP code (default: 1234 for admin allowlisted phones)
DEV_OTP_CODE=

# Vercel Blob (for admin image uploads + admin-created campaigns/store items JSON)
BLOB_READ_WRITE_TOKEN=

# Firebase Web (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (server-only)
FIREBASE_SERVICE_ACCOUNT_JSON=
